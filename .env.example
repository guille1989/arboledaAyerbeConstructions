# Copie este archivo como .env y complete los valores.
# En Vercel: Project Settings → Environment Variables (mismos nombres).

# WhatsApp en formato internacional, solo dígitos (código de país + número, sin "+")
VITE_WHATSAPP_NUMBER=
# Texto visible del número (opcional; si se deja vacío se muestra "+<número>")
VITE_WHATSAPP_DISPLAY=

# Correo electrónico de contacto
VITE_CONTACT_EMAIL=jvarboleda@ingearboleda.com
